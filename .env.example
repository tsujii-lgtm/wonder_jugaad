# ジュガール API の接続先（ログイン後の画面と同じホスト。違う場合は API 仕様に合わせて変更）
JUGAAD_BASE_URL=https://smartflow.vebuin.com
# ジュガールで発行した API キー（このファイルをコピーした .env にだけ書き、コミットしない）
JUGAAD_API_KEY=
# 認証ヘッダ。Bearer 方式なら既定のまま。X-API-KEY 方式なら HEADER=X-API-KEY / SCHEME= に
JUGAAD_AUTH_HEADER=Authorization
JUGAAD_AUTH_SCHEME=Bearer
# Swagger / OpenAPI 仕様（ファイルパスか URL）。設定するとエンドポイントごとにツールができる
JUGAAD_OPENAPI=
# true にすると申請の作成・更新などの書き込み操作も許可する（既定は読み取りのみ）
JUGAAD_ALLOW_WRITE=false
# claude.ai から接続する URL に含める秘密の文字列（openssl rand -hex 24 などで生成）
MCP_ACCESS_TOKEN=
PORT=8787
